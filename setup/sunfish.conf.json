{
    "version": "1.0",
    "description": "sunfish - dystrybucja z kursu Yocto (linuxdev.pl) dla Raspberry Pi 4, release 6.0 'wrynose'",
    "expires": "2030-05-31",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "2.18"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-raspberrypi",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-webkit": {
            "git-remote": {
                "uri": "https://github.com/Igalia/meta-webkit",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-application": {
            "git-remote": {
                "uri": "https://github.com/KarolPWr/meta-application",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-fish": {
            "git-remote": {
                "uri": "https://github.com/KarolPWr/meta-fish",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-gui": {
            "git-remote": {
                "uri": "https://github.com/KarolPWr/meta-gui",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "setup-dir-name": "$distro-wrynose",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-raspberrypi",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-application",
                    "meta-fish",
                    "meta-webkit",
                    "meta-openembedded/meta-multimedia",
                    "meta-gui",
                    "meta-openembedded/meta-webserver"
                ],
                "oe-fragments": [
                    "meta-fish/rpi4-serial-console"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Platforma docelowa",
                        "options": [
                            {
                                "name": "machine/raspberrypi4-64",
                                "description": "Raspberry Pi 4, 64-bit (platforma kursu)"
                            },
                            {
                                "name": "machine/raspberrypi4",
                                "description": "Raspberry Pi 4, 32-bit"
                            },
                            {
                                "name": "machine/qemuarm64",
                                "description": "ARMv8 pod QEMU - do prób bez sprzętu"
                            }
                        ]
                    },
                    "distro": {
                        "description": "Dystrybucja",
                        "options": [
                            {
                                "name": "distro/sunfish",
                                "description": "sunfish - systemd, wayland, obrazy kursowe"
                            },
                            {
                                "name": "distro/moonfish",
                                "description": "moonfish - wariant na sysvinit"
                            }
                        ]
                    }
                },
                "configurations": [
                    {
                        "name": "sunfish",
                        "description": "Konfiguracja kursowa - obraz produkcyjny (prod-image)"
                    },
                    {
                        "name": "sunfish-dev",
                        "description": "Konfiguracja kursowa z ulatwieniami developerskimi: logowanie na roota bez hasla, narzedzia debugowe, debugfs",
                        "oe-fragments": [
                            "core/yocto/root-login-with-empty-password",
                            "meta-fish/dev-tools",
                            "meta-fish/debugfs"
                        ]
                    }
                ]
            }
        ]
    }
}
