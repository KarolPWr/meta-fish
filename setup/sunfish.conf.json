{
    "version": "1.0",
    "description": "sunfish - dystrybucja z kursu Yocto (linuxdev.pl) dla Raspberry Pi 4, release 6.0 'wrynose'. Warstwy zewnetrzne sa przypiete do commitow, na ktorych obraz zostal zbudowany i sprawdzony na sprzecie; trzy warstwy autorskie sledza galaz 'wrynose', zeby odbiorca dostawal ich aktualny stan.",
    "expires": "2030-05-31",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "0ad6c1c34a5e07a5f8dd66ab248c1e7b37b69fa9"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "f7397af248e1e338929d70a910b0fbc2341528ec"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "1b132647002eea43a2c7a7f857f63f42dacbc26c"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-raspberrypi",
                "branch": "wrynose",
                "rev": "f62c67921474370829d24a4fa01ef88543f3906b"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "wrynose",
                "rev": "14282a02be9c74a1276a7cda7d6c89e054699a11"
            }
        },
        "meta-webkit": {
            "git-remote": {
                "uri": "https://github.com/Igalia/meta-webkit",
                "branch": "wrynose",
                "rev": "13a0e5a5cc49516e3e3c91fdc5e7033e3c3dfb73"
            }
        },
        "meta-application": {
            "git-remote": {
                "uri": "https://github.com/KarolPWr/meta-application",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-fish": {
            "git-remote": {
                "uri": "https://github.com/KarolPWr/meta-fish",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-gui": {
            "git-remote": {
                "uri": "https://github.com/KarolPWr/meta-gui",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "setup-dir-name": "$distro-wrynose",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-raspberrypi",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-application",
                    "meta-fish",
                    "meta-webkit",
                    "meta-openembedded/meta-multimedia",
                    "meta-gui",
                    "meta-openembedded/meta-webserver"
                ],
                "oe-fragments": [
                    "meta-fish/rpi4-serial-console"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Platforma docelowa",
                        "options": [
                            {
                                "name": "machine/raspberrypi4-64",
                                "description": "Raspberry Pi 4, 64-bit (platforma kursu)"
                            },
                            {
                                "name": "machine/raspberrypi4",
                                "description": "Raspberry Pi 4, 32-bit"
                            },
                            {
                                "name": "machine/qemuarm64",
                                "description": "ARMv8 pod QEMU - do prob bez sprzetu"
                            }
                        ]
                    },
                    "distro": {
                        "description": "Dystrybucja",
                        "options": [
                            {
                                "name": "distro/sunfish",
                                "description": "sunfish - systemd, wayland, obrazy kursowe"
                            },
                            {
                                "name": "distro/moonfish",
                                "description": "moonfish - wariant na sysvinit"
                            }
                        ]
                    }
                },
                "configurations": [
                    {
                        "name": "sunfish",
                        "description": "Wariant konsolowy - bez warstwy graficznej. Cel do zbudowania: 'bitbake core-image-base'."
                    },
                    {
                        "name": "sunfish-kiosk",
                        "description": "Kiosk GUI z modulu 6 kursu: weston + przegladarka cog na pelnym ekranie + aplikacja web-toggle sterujaca dioda przez GPIO. Cel: 'bitbake core-image-base'.",
                        "oe-fragments": [
                            "meta-fish/gui"
                        ]
                    },
                    {
                        "name": "sunfish-dev",
                        "description": "Kiosk GUI plus ulatwienia developerskie: logowanie na roota bez hasla, SSH (dropbear), narzedzia debugowe (gdb, strace), debugfs. Do pracy na sprzecie.",
                        "oe-fragments": [
                            "meta-fish/gui",
                            "core/yocto/root-login-with-empty-password",
                            "meta-fish/dev-tools",
                            "meta-fish/debugfs"
                        ]
                    }
                ]
            }
        ]
    }
}
